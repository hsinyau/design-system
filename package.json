{
  "name": "design-system-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hsinyau/docs dev",
    "build": "pnpm --filter @hsinyau/docs build",
    "preview": "pnpm --filter @hsinyau/docs preview",
    "build:lib": "pnpm --filter @hsinyau/design-system build",
    "check": "pnpm --filter @hsinyau/docs check && pnpm run check:tokens && pnpm run check:classes",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "typecheck": "pnpm --filter @hsinyau/docs typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
