// Cloudflare Workers 静态资源部署配置。
//
// 本站是纯静态产物（astro.config.mjs 里 output: 'static'），因此不需要
// @astrojs/cloudflare 适配器，也不需要 Worker 脚本：dist/ 直接作为静态资源托管。
// 有这份配置时，wrangler deploy 不会再尝试为项目自动安装适配器。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design-system",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    // 目录形式的路由：/components/button/ 与 /components/button 都能命中
    "html_handling": "auto-trailing-slash",
    // dist/404.html 由 src/pages/404.astro 生成
    "not_found_handling": "404-page"
  }
}
