---
/**
 * Switch —— 即时生效的布尔开关。
 *
 * 用 <input type="checkbox" role="switch">：语义与键盘行为和原生一致，
 * 轨道是直角矩形，滑块纯色，只有一个 16px 的位移。
 */
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'input'>, 'class' | 'type' | 'role'> {
  class?: string
}

const { class: className, ...rest } = Astro.props

const classes = ['zz-switch', rest.disabled && 'zz-switch--disabled', className]
  .filter(Boolean)
  .join(' ')
---

<label class={classes}>
  <input {...rest} class="zz-switch__input" type="checkbox" role="switch" />
  <span class="zz-switch__track" aria-hidden="true">
    <span class="zz-switch__thumb"></span>
  </span>
  <span class="zz-switch__label"><slot /></span>
</label>
