{
  "name": "@hsinyau/design-system",
  "version": "0.1.1",
  "description": "直角、等宽、1px 描边的 CSS 设计系统：语义 token、两套主题与一组框架无关的组件类",
  "keywords": [
    "design-system",
    "css",
    "tailwindcss",
    "tokens",
    "themes",
    "monospace"
  ],
  "homepage": "https://github.com/hsinyau/design-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsinyau/design-system.git",
    "directory": "packages/design-system"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src/styles",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/styles/index.css",
    "./styles.css": "./src/styles/index.css",
    "./standalone.css": "./dist/design-system.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./theme-transition.css": "./src/styles/theme-transition.css",
    "./components/*.css": "./src/styles/components/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-standalone.mjs",
    "prepare": "node scripts/build-standalone.mjs",
    "prepublishOnly": "node scripts/build-standalone.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
