---
/**
 * Checkbox —— 自绘方形勾选框，真实 <input type="checkbox"> 保留在 DOM 里。
 *
 * 视觉层 .zz-check__box 由相邻选择器（:checked / :indeterminate）驱动，
 * 焦点环从透明 input 转发到视觉层，键盘与表单行为仍是原生的。
 * indeterminate 只负责视觉与 aria；运行时建议同时设置 el.indeterminate = true。
 */
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'input'>, 'class' | 'type'> {
  indeterminate?: boolean
  class?: string
}

const { indeterminate = false, class: className, ...rest } = Astro.props

const classes = ['zz-check', rest.disabled && 'zz-check--disabled', className]
  .filter(Boolean)
  .join(' ')
---

<label class={classes}>
  <input
    {...rest}
    class="zz-check__input"
    type="checkbox"
    aria-checked={indeterminate ? 'mixed' : undefined}
    data-indeterminate={indeterminate ? 'true' : undefined}
  />
  <span class="zz-check__box" aria-hidden="true"></span>
  <span class="zz-check__label"><slot /></span>
</label>
